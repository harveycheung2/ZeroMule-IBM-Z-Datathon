# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data files (prevent committing datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Weights & Pretrained Models
weights/*
!weights/.gitkeep
models/*.pkl
models/*.joblib
models/*.onnx
models/*.pt
models/*.h5

# Results & Plots (prevent committing generated result binaries)
results/*.csv
results/*.json
results/plots/*
!results/.gitkeep
!results/plots/.gitkeep

# Environment secrets
.env
.env.local
*.secret
